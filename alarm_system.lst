 190          /* =========================================================
 191             ADC0808 FUNCTION
 192             ========================================================= */
 193          
 194          unsigned char adc_read(void)
 195          {
 196   1          unsigned char value;
 197   1      
 198   1          /*
 199   1             Start ADC conversion
 200   1          */
 201   1      
 202   1          ADC_ALE = 1;
 203   1          ADC_START = 1;
 204   1      
 205   1          delay_ms(1);
 206   1      
 207   1          ADC_ALE = 0;
 208   1          ADC_START = 0;
 209   1      
 210   1          /*
 211   1             Wait for conversion.
 212   1      
 213   1             EOC LOW  = conversion in progress
 214   1             EOC HIGH = conversion complete
 215   1          */
 216   1      
 217   1          while(ADC_EOC == 1);
 218   1          while(ADC_EOC == 0);
 219   1      
 220   1          /* Enable ADC output */
 221   1          ADC_OE = 1;
 222   1      
 223   1          delay_ms(1);
 224   1      
 225   1          value = ADC_DATA;
 226   1      
 227   1          /* Disable ADC output */
 228   1          ADC_OE = 0;
 229   1      
 230   1          return value;
 231   1      }
