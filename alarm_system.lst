 501          
 502          unsigned char calculate_index(unsigned int temperature,
 503                                        unsigned char flame,
 504                                        unsigned char gas,
 505                                        unsigned char vibration,
 506                                        unsigned char emergency)
 507          {
 508   1          unsigned int risk = 0;
 509   1          if (emergency) return 0;
 510   1          if (temperature >= 50) risk += 30;
 511   1          else if (temperature >= 40) risk += 20;
 512   1          else if (temperature >= 30) risk += 10;
 513   1          if (flame) risk += 30;
 514   1          if (gas) risk += 25;
 515   1          if (vibration) risk += 15;
 516   1          if (risk >= 100) return 0;
 517   1          return (unsigned char)(100 - risk);
 518   1      }
 519          
 520          unsigned char classify_alarm(unsigned int temperature,
 521                                       unsigned char flame,
 522                                       unsigned char gas,
 523                                       unsigned char vibration,
 524                                       unsigned char emergency)
 525          {
 526   1          if (emergency) return STATE_EMERGENCY;
 527   1          if (temperature >= 50 || flame || gas) return STATE_DANGER;
 528   1          if (temperature >= 40 || vibration) return STATE_WARNING;
 529   1          if (temperature >= 30) return STATE_PREWARN;
 530   1          return STATE_SAFE;
 531   1      }
