 117          
 118          /* Set LCD cursor
 119             row = 0 or 1
 120             col = 0 to 15
 121          */
 122          void lcd_goto(unsigned char row, unsigned char col)
 123          {
 124   1          if(row == 0)
 125   1          {
 126   2              lcd_cmd(0x80 + col);
 127   2          }
 128   1          else
 129   1          {
 130   2              lcd_cmd(0xC0 + col);
 131   2          }
 132   1      }
 133          
 134          
 135          /* Clear LCD */
 136          void lcd_clear(void)
 137          {
 138   1          lcd_cmd(0x01);
 139   1          delay_ms(2);
 140   1      }
 141          
 142          
 143          /* LCD initialization */
 144          void lcd_init(void)
 145          {
 146   1          LCD_RS = 0;
 147   1          LCD_EN = 0;
 148   1      
 149   1          delay_ms(20);
 150   1      
 151   1          /* Force LCD into 4-bit mode */
 152   1          lcd_nibble(0x03);
 153   1          delay_ms(5);
 154   1      
 155   1          lcd_nibble(0x03);
 156   1          delay_ms(1);
 157   1      
 158   1          lcd_nibble(0x03);
 159   1          delay_ms(1);
 160   1      
 161   1          lcd_nibble(0x02);
 162   1      
 163   1          /* 4-bit, 2-line, 5x8 font */
 164   1          lcd_cmd(0x28);
 165   1      
 166   1          /* Display ON, cursor OFF */
 167   1          lcd_cmd(0x0C);
 168   1      
 169   1          /* Entry mode */
 170   1          lcd_cmd(0x06);
 171   1      
 172   1          /* Clear display */
 173   1          lcd_cmd(0x01);
 174   1      
 175   1          delay_ms(5);
 176   1      }
