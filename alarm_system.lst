  43          
  44          void delay_ms(unsigned int ms)
  45          {
  46   1          unsigned int i, j;
  47   1      
  48   1          for(i = 0; i < ms; i++)
  49   1          {
  50   2              for(j = 0; j < 123; j++)
  51   2              {
  52   3                  ;
  53   3              }
  54   2          }
