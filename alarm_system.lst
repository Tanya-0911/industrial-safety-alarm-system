 234          /* =========================================================
 235             TEMPERATURE CALCULATION
 236             ========================================================= */
 237          
 238          unsigned int get_temperature(void)
 239          {
 240   1          unsigned char adc_value;
C51 COMPILER V9.60.7.0   ALARM_SYSTEM                                                      10/19/2026 17:47:32 PAGE 5   

 241   1          unsigned int temperature;
 242   1      
 243   1          adc_value = adc_read();
 244   1      
 245   1          /*
 246   1             ADC0808:
 247   1             VREF+ = 5V
 248   1             VREF- = 0V
 249   1      
 250   1             8-bit ADC = 256 levels
 251   1      
 252   1             LM35:
 253   1             10 mV / degree C
 254   1      
 255   1             Temperature = ADC value * 500 / 256
 256   1          */
 257   1      
 258   1          temperature = ((unsigned int)adc_value * 500) / 256;
 259   1      
 260   1          return temperature;
 261   1      }
