 267          
 268          void display_temperature(unsigned int temperature)
 269          {
 270   1          lcd_string("TEMP: ");
 271   1      
 272   1          if(temperature >= 100)
 273   1          {
 274   2              lcd_data((temperature / 100) + '0');
 275   2              lcd_data(((temperature / 10) % 10) + '0');
 276   2              lcd_data((temperature % 10) + '0');
 277   2          }
 278   1          else if(temperature >= 10)
 279   1          {
 280   2              lcd_data((temperature / 10) + '0');
 281   2              lcd_data((temperature % 10) + '0');
 282   2          }
 283   1          else
 284   1          {
 285   2              lcd_data(temperature + '0');
 286   2          }
 287   1      
 288   1          lcd_string(" C");
 289   1      }
