 179          /* =========================================================
 180             ADC0808 FUNCTION
 181             ========================================================= */
 182          
 183          unsigned char adc_read(void)
 184          {
 185   1          unsigned char value;
 186   1      
 187   1          /*
 188   1             Start ADC conversion
 189   1             ALE and START are pulsed HIGH
 190   1          */
 191   1      
 192   1          ADC_ALE = 1;
 193   1          ADC_START = 1;
 194   1      
 195   1          delay_ms(1);
 196   1      
 197   1          ADC_ALE = 0;
 198   1          ADC_START = 0;
 199   1      
 200   1          /*
 201   1             Wait for conversion to complete.
 202   1      
 203   1             ADC0808 EOC normally goes LOW while converting
 204   1             and HIGH when conversion is complete.
 205   1          */
 206   1      
 207   1          while(ADC_EOC == 1);
 208   1          while(ADC_EOC == 0);
 209   1      
 210   1          /* Enable ADC output */
 211   1          ADC_OE = 1;
 212   1      
 213   1          delay_ms(1);
 214   1      
 215   1          value = ADC_DATA;
 216   1      
 217   1          /* Disable ADC output */
 218   1          ADC_OE = 0;
 219   1      
 220   1          return value;
 221   1      }
 222          
 223          
 224          /* =========================================================
 225             TEMPERATURE CALCULATION
 226             ========================================================= */
 227          
 228          unsigned int get_temperature(void)
 229          {
 230   1          unsigned char adc_value;
 231   1          unsigned int temperature;
 232   1      
 233   1          adc_value = adc_read();
 234   1      
 235   1          /*
 236   1             ADC0808:
 237   1             VREF+ = 5V
 238   1             VREF- = 0V
 239   1      
 240   1             ADC resolution = 256 levels
C51 COMPILER V9.60.7.0   ALARM_SYSTEM                                                      09/14/2026 17:55:21 PAGE 5   

 241   1      
 242   1             LM35:
 243   1             10 mV / °C
 244   1      
 245   1             Temperature:
 246   1             ADC value * 500 / 256
 247   1          */
 248   1      
 249   1          temperature = ((unsigned int)adc_value * 500) / 256;
 250   1      
 251   1          return temperature;
 252   1      }
