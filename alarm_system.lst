 554          /* Keep the original hazard display functions and priority messages. */
 555          void display_sensor_details(unsigned int temperature,
 556                                      unsigned char alarm_count)
 557          {
 558   1          if (EMERGENCY == 0) display_emergency_alert();
 559   1          else if (temperature >= 50) display_critical_temperature(temperature);
 560   1          else if (alarm_count >= 2) display_multiple_sensors();
 561   1          else if (FLAME == 0) display_flame_alert();
 562   1          else if (GAS == 0) display_gas_alert();
 563   1          else if (VIBRATION == 0) display_vibration_alert();
 564   1          else if (temperature >= 40)
 565   1          {
 566   2              lcd_clear();
 567   2              lcd_goto(0, 0);
 568   2              lcd_string("TEMP WARNING");
 569   2              lcd_goto(1, 0);
 570   2              display_temperature(temperature);
 571   2          }
 572   1          else if (temperature >= 30)
 573   1          {
 574   2              lcd_clear();
 575   2              lcd_goto(0, 0);
 576   2              lcd_string("TEMP PRE-WARN");
 577   2              lcd_goto(1, 0);
 578   2              display_temperature(temperature);
 579   2          }
 580   1          else
 581   1          {
 582   2              lcd_clear();
 583   2              lcd_goto(0, 0);
 584   2              lcd_string("SYSTEM NORMAL");
 585   2              lcd_goto(1, 0);
 586   2              display_temperature(temperature);
 587   2          }
 588   1      }
