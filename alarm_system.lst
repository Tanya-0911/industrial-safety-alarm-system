  58          /* =========================================================
  59             LCD FUNCTIONS
  60             ========================================================= */
  61          
  62          void lcd_pulse(void)
  63          {
  64   1          LCD_EN = 1;
  65   1          delay_ms(1);
  66   1          LCD_EN = 0;
  67   1          delay_ms(1);
  68   1      }
  69          
  70          
  71          /* Send one 4-bit nibble to LCD */
  72          void lcd_nibble(unsigned char nibble)
  73          {
  74   1          LCD_D4 = (nibble >> 0) & 1;
  75   1          LCD_D5 = (nibble >> 1) & 1;
  76   1          LCD_D6 = (nibble >> 2) & 1;
  77   1          LCD_D7 = (nibble >> 3) & 1;
  78   1      
  79   1          lcd_pulse();
  80   1      }
  81          
  82          
  83          /* Send command */
  84          void lcd_cmd(unsigned char cmd)
  85          {
  86   1          LCD_RS = 0;
  87   1      
  88   1          lcd_nibble(cmd >> 4);
  89   1          lcd_nibble(cmd & 0x0F);
  90   1      
  91   1          delay_ms(2);
  92   1      }
  93          
  94          
  95          /* Send character */
  96          void lcd_data(unsigned char dat)
  97          {
  98   1          LCD_RS = 1;
  99   1      
 100   1          lcd_nibble(dat >> 4);
 101   1          lcd_nibble(dat & 0x0F);
 102   1      
 103   1          delay_ms(1);
 104   1      }
 105          
 106          
 107          /* Send string */
 108          void lcd_string(char *str)
 109          {
 110   1          while(*str)
 111   1          {
 112   2              lcd_data(*str);
 113   2              str++;
 114   2          }
 115   1      }
